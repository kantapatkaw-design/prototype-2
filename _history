n":"4.1.32","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block></xml>","main.ts":"// Create background canvas (MakeCode Arcade screen is 160x120)\nlet bg = image.create(160, 120)\nscene.setBackgroundImage(bg)\n\n// Car state\nlet x = 80\nlet y = 60\nlet vx = 0\nlet vy = 0\nlet angle = 0\n\ngame.onUpdate(function () {\n    let dt = game.eventContext().deltaTime\n\n    // Controls: Up = Gas, Down = Brake/Reverse, Left/Right = Steer, A = Drift\n    let throttle = controller.up.isPressed() ? 1 : 0\n    let brake = controller.down.isPressed() ? 1 : 0\n    let steer = (controller.right.isPressed() ? 1 : 0) - (controller.left.isPressed() ? 1 : 0)\n    let drift = controller.A.isPressed()\n\n    // Forward and sideways unit vectors\n    let fx = Math.cos(angle)\n    let fy = Math.sin(angle)\n    let rx = -fy\n    let ry = fx\n\n    // Split velocity into forward speed and sideways drift speed\n    let forward = vx * fx + vy * fy\n    let sideways = vx * rx + vy * ry\n\n    // Gas & Brake\n    forward += (throttle * 140 - brake * 160) * dt\n    forward *= 0.98\n\n    // Sideways grip (Hold A to slide/drift)\n    let grip = drift ? 1.5 : 8.5\n    sideways -= sideways * Math.min(1, grip * dt)\n\n    // Recombine and move car\n    vx = fx * forward + rx * sideways\n    vy = fy * forward + ry * sideways\n    x += vx * dt\n    y += vy * dt\n\n    // Wrap around screen edges so you don't get stuck off-screen\n    if (x < 0) x += 160\n    if (x > 160) x -= 160\n    if (y < 0) y += 120\n    if (y > 120) y -= 120\n\n    // Steering (only turns when moving; reverses steering when backing up)\n    let speed = Math.sqrt(vx * vx + vy * vy)\n    if (speed > 5) {\n        let dir = forward >= 0 ? 1 : -1\n        let turnFactor = Math.min(1, speed / 35)\n        angle += steer * 3.8 * turnFactor * dir * dt\n    }\n\n    // Draw road & rotating car\n    bg.fill(11) // Dark gray asphalt\n    drawCar(bg, x, y, angle)\n})\n\nfunction drawCar(img: Image, cx: number, cy: number, a: number) {\n    let fx = Math.cos(a)\n    let fy = Math.sin(a)\n    let rx = -fy\n    let ry = fx\n\n    // 4 corners of the car (length 14, width 8)\n    let flx = cx + fx * 7 - rx * 4, fly = cy + fy * 7 - ry * 4\n    let frx = cx + fx * 7 + rx * 4, fry = cy + fy * 7 + ry * 4\n    let brx = cx - fx * 7 + rx * 4, bry = cy - fy * 7 + ry * 4\n    let blx = cx - fx * 7 - rx * 4, bly = cy - fy * 7 - ry * 4\n\n    // Fill red car body using two triangles\n    img.fillTriangle(flx, fly, frx, fry, brx, bry, 2)\n    img.fillTriangle(flx, fly, brx, bry, blx, bly, 2)\n\n    // Yellow nose dot so you always see which way is forward\n    img.fillCircle(cx + fx * 5, cy + fy * 5, 1, 5)\n}","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Prototype\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1795671675038,"editorVersion":"4.1.32","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"sY?-xvBxWrkNTosBCx-$\">steer</variable><variable id=\"nm4L0lyJ8htyL|bL7u=o\">drift</variable><variable id=\"M_IN_*7mYYoux#9_d643\">pixelColor</variable><variable id=\"c`Zv]5|]1Wt}TaQq=:?{\">trackImg</variable><variable id=\"^Uj_x#QA$J4^.9~et{Mv\">px</variable><variable id=\"+?T@1T(4$}tjJw4k._k~\">py</variable><variable id=\"ciOZsL%:bq1r6f$kB|qU\">onRoad</variable><variable id=\"OVko=`wzLs9#sqIUKGG$\">fx</variable><variable id=\"Y:NXIJ[?B[]_^2}6mh?~\">angle</variable><variable id=\"ENSi-1@IxTce6v(dUp[J\">fy</variable><variable id=\".OJc_AK4?Co^sE]r/4cr\">rx</variable><variable id=\"l/4W[:0pg.z!a/i;X)f)\">ry</variable><variable id=\"2L_S#`1}Nzz-Y?Ar{zRN\">forward</variable><variable id=\"FmLCt~konI]@v)Ux}/N`\">vx</variable><var