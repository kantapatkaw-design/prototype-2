lx, fly, brx, bry, blx, bly, 1)\nimg.fillCircle(cx + fx2 * 3, cy + fy2 * 3, 2, 2)\n}\nfunction drawTrack (img2: Image) {\n    // Green grass\n    img2.fill(7)\n    // Draw red curbs and dark gray asphalt along waypoints\n    for (let j = 0; j <= trackX.length - 1; j++) {\n        next = (j + 1) % trackX.length\n        drawThickLine(img2, trackX[j], trackY[j], trackX[next], trackY[next], roadWidth + 4, 2)\n    }\n    for (let k = 0; k <= trackX.length - 1; k++) {\n        next2 = (k + 1) % trackX.length\n        drawThickLine(img2, trackX[k], trackY[k], trackX[next2], trackY[next2], roadWidth, 11)\n    }\n    // White Start / Finish line\n    img2.fillRect(58, 14, 2, 21, 1)\n}\nfunction drawThickLine (img2: Image, x0: number, y0: number, x1: number, y1: number, width: number, color: number) {\n    r = Math.floor(width / 2)\n    steps = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0))\n    for (let s = 0; s <= steps; s++) {\n        let t = steps == 0 ? 0 : s / steps\ncx = Math.round(x0 + (x1 - x0) * t)\n        cy = Math.round(y0 + (y1 - y0) * t)\n        img.fillCircle(cx, cy, r, color)\n    }\n}\n/**\n * Store tire skid marks\n */\nlet kmh = 0\nlet turnFactor = 0\nlet speed = 0\nlet sideways = 0\nlet vy = 0\nlet vx = 0\nlet forward = 0\nlet ry = 0\nlet rx = 0\nlet fy = 0\nlet angle = 0\nlet fx = 0\nlet onRoad = false\nlet pixelColor = 0\nlet drift = false\nlet steer = 0\nlet cy = 0\nlet cx = 0\nlet steps = 0\nlet r = 0\nlet next2 = 0\nlet next = 0\nlet bly = 0\nlet blx = 0\nlet bry = 0\nlet brx = 0\nlet fry = 0\nlet frx = 0\nlet fly = 0\nlet flx = 0\nlet ry2 = 0\nlet rx2 = 0\nlet fy2 = 0\nlet fx2 = 0\nlet roadWidth = 0\nlet trackY: number[] = []\nlet trackX: number[] = []\n// Create background canvas (MakeCode Arcade screen is 160x120)\nlet bg = image.create(160, 120)\nscene.setBackgroundImage(bg)\n// Closed-loop track waypoints\ntrackX = [\n30,\n130,\n140,\n130,\n95,\n80,\n55,\n25,\n20\n]\ntrackY = [\n24,\n24,\n42,\n95,\n100,\n72,\n98,\n92,\n45\n]\nroadWidth = 22\n// Pre-render the static track image so it runs smoothly at 60fps\nlet trackImg = image.create(160, 120)\ndrawTrack(trackImg)\n// Car state (starts on top straight facing right)\nlet x = 45\nlet y = 24\ngame.onUpdate(function () {\n    let skidY: number[] = []\n    let skidX: number[] = []\n    let dt = game.eventContext().deltaTime\nlet throttle = controller.up.isPressed() ? 1 : 0\nlet brake = controller.down.isPressed() ? 1 : 0\nsteer = (controller.right.isPressed() ? 1 : 0) - (controller.left.isPressed() ? 1 : 0)\n    drift = controller.A.isPressed()\n    let px = Math.clamp(0, 159, Math.round(x))\nlet py = Math.clamp(0, 119, Math.round(y))\npixelColor = trackImg.getPixel(px, py)\n    onRoad = pixelColor == 11 || pixelColor == 1 || pixelColor == 2\n    // Forward and sideways unit vectors\n    fx = Math.cos(angle)\n    fy = Math.sin(angle)\n    rx = 0 - fy\n    ry = fx\n    // Split velocity into forward speed and sideways drift speed\n    forward = vx * fx + vy * fy\n    sideways = vx * rx + vy * ry\n    let surfaceDrag = onRoad ? 0.98 : 0.91\nforward += (throttle * 145 - brake * 170) * dt\n    forward *= surfaceDrag\nlet grip = !onRoad ? 2.8 : (drift ? 1.5 : 8.5)\nsideways += 0 - sideways * Math.min(1, grip * dt)\n    // Recombine and move car\n    vx = fx * forward + rx * sideways\n    vy = fy * forward + ry * sideways\n    x += vx * dt\n    y += vy * dt\n    x = Math.clamp(6, 154, x)\ny = Math.clamp(6, 114, y)\n// Steering (only turns when moving; reverses when backing up)\n    speed = Math.sqrt(vx * vx + vy * vy)\n    if (speed > 5) {\n        let dir = forward >= 0 ? 1 : -1\nturnFactor = Math.min(1, speed / 35)\n        angle += steer * 3.8 * turnFactor * dir * dt\n    }\n    // Record tire skid marks when sliding sideways\n    if (Math.abs(sideways) > 15 && speed > 20) {\n        skidX.push(x - fx * 5)\n        skidY.push(y - fy * 5)\n        if (skidX.length > 80) {\n            skidX.shift()\n            skidY.shift()\n        }\n    }\n    bg.drawImage(trackImg, 0, 0)\n// 2. Draw tire skid marks\n    for (let i = 0; i <= skidX.length - 1; i++) {\n        bg.setPixel(Math.round(skidX[i]), Math.round(skidY[i]), 15)\n    }\n    // 3. Draw educational physics vectors (Green = Nose, Yellow = Momentum)\n    bg.drawLine(x, y, x + fx * 14, y + fy * 14, 7)\n    bg.drawLine(x, y, x + vx * 0.18, y + vy * 0.18, 5)\n    // 4. Draw rotating car\n    drawCar(bg, x, y, angle)\n    // 5. Minimal Speed & Drift HUD (Top-Left)\n    kmh = Math.round(speed * 1.4)\n    bg.fillRect(2, 2, 54, 12, 15)\n    bg.print(kmh + \" km/h\", 4, 4, 1)\nif (Math.abs(sideways) > 15 && speed > 20) {\n        bg.print(\"DRIFT\", 60, 4, 5)\n    }\n})\n","README.md":" ","assets.json":"","track.ts":"\n/**\n* Use this file to define custom functions and blocks.\n* Read more at https://arcade.makecode.com/blocks/custom\n*/\n\nenum MyEnum {\n    //% block=\"one\"\n    One,\n    //% block=\"two\"\n    Two\n}\n\n/**\n * Custom blocks\n */\n//% weight=100 color=#0fbc11 icon=\"\"\nnamespace custom {\n    /**\n     * TODO: describe your function here\n     * @param n describe parameter here, eg: 5\n     * @param s describe parameter here, eg: \"Hello\"\n     * @param e describe parameter here\n     */\n    //% block\n    export function foo(n: number, s: string, e: MyEnum): void {\n        // Add code here\n    }\n\n    /**\n     * TODO: describe your function here\n     * @param value describe value here, eg: 5\n     */\n    //% block\n    export function fib(value: number): number {\n        return value <= 1 ? value : fib(value -1) + fib(value - 2);\n    }\n}\n","pxt.json":"{\n    \"name\": \"Prototype\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"track.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1795671826260}